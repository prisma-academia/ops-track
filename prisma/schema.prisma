generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppModule {
  STATION
  FLEET
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum ActorType {
  PLATFORM_USER
  TENANT_USER
  CLIENT
  SYSTEM
}

enum SessionUserType {
  PLATFORM
  TENANT
  CLIENT
}

enum SessionScope {
  FULL
  MUST_CHANGE_PASSWORD
}

enum OtpPurpose {
  CLIENT_LOGIN
  CLIENT_SIGNUP
  TENANT_REGISTRATION
  TENANT_OWNER_CHANGE_EMAIL
}

enum OrganizationType {
  INTERNAL // Fleet manager's own operations
  EXTERNAL // Client company managed by fleet manager
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  status       TenantStatus @default(ACTIVE)
  ownerUserId  String?
  companyEmail String?
  companyPhone String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  settingsJson Json         @default("{}")
  createdAt    DateTime     @default(now())
  archivedAt   DateTime?

  users                      TenantUser[]
  clients                    Client[]
  pendingClientRegistrations PendingClientRegistration[]
  roleTemplates              RoleTemplate[]
  templates                  Template[]
  activityLogs               ActivityLog[]
  organizations              Organization[]
  stations                   Station[]
  tanks                      Tank[]
  priceControls              PriceControl[]
  SalesLogs                  SalesLog[]
  dailyStockReports          DailyStockReport[]
  tankDippings               TankDipping[]
  tickets                    Ticket[]
  customers                  Customer[]
  waybills                   Waybill[]
  waybillAllocations         WaybillAllocation[]
  waybillDippings            WaybillDipping[]
  pumps                      Pump[]
  nozzles                    Nozzle[]
  shiftLogs                  ShiftLog[]
  expenses                   Expense[]

  activeModules     String[]           @default(["STATION"])
  transporters      Transporter[]
  trucks            Truck[]
  drivers           Driver[]
  orders            Order[]
  transports        Transport[]
  sales             Sale[]
  transactions      Transaction[]
  transportLossLogs TransportLossLog[]
  dippingSessions   DippingSession[]
  bankAccounts      BankAccount[]
  varianceLogs      VarianceLog[]

  @@index([status])
}

model PlatformUser {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  status              UserStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isSuperAdmin        Boolean    @default(false)
  permissions         String[]   @default([])
  createdAt           DateTime   @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
}

model TenantUser {
  id                  String     @id @default(cuid())
  tenantId            String
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  status              UserStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isOwner             Boolean      @default(false)
  organizationId      String?
  organization        Organization? @relation("OrgUsers", fields: [organizationId], references: [id], onDelete: SetNull)
  activeModules       AppModule[]  @default([STATION, FLEET])
  stationPermissions  String[]     @default([])
  fleetPermissions    String[]     @default([])
  createdAt           DateTime     @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  expoPushTokens      String[]   @default([])

  stations                Station[]        @relation("StationStaff")
  recordedSalesLogs       SalesLog[]       @relation("SalesRecordedBy")
  approvedSalesLogs       SalesLog[]       @relation("SalesApprovedBy")
  raisedTickets           Ticket[]         @relation("TicketRaiser")
  approvedTickets         Ticket[]         @relation("TicketApprover")
  recordedWaybills        Waybill[]
  attendantShifts         ShiftLog[]       @relation("AttendantShifts")
  reconciledShifts        ShiftLog[]       @relation("ReconciledShifts")
  recordedExpenses        Expense[]        @relation("ExpenseRecordedBy")
  approvedExpenses        Expense[]        @relation("ExpenseApprovedBy")
  recordedWaybillDippings WaybillDipping[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String?
  mustChangePassword  Boolean      @default(false)
  status              ClientStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  profileJson         Json         @default("{}")
  createdAt           DateTime     @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model PasswordResetToken {
  id         String          @id @default(cuid())
  tokenHash  String          @unique
  userType   SessionUserType
  userId     String
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([expiresAt])
}

/// In-flight client self-signup: created after form+password, deleted after OTP verifies.
model PendingClientRegistration {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  otherName    String?
  phone        String?
  profileJson  Json     @default("{}")
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RoleTemplate {
  id          String    @id @default(cuid())
  scope       RoleScope
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  module      AppModule @default(STATION)
  permissions String[]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([scope, tenantId, module, name])
  @@index([scope, tenantId, module])
}

model Permission {
  key         String @id
  module      String
  description String
}

model ActivityLog {
  id         String    @id @default(cuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorType  ActorType
  actorId    String?
  module     AppModule @default(STATION)
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
}

model OtpRequest {
  id         String     @id @default(cuid())
  identifier String
  codeHash   String
  purpose    OtpPurpose
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([identifier, createdAt])
  @@index([tenantId])
}

model Session {
  id        String          @id
  userId    String
  userType  SessionUserType
  tenantId  String?
  scope     SessionScope    @default(FULL)
  issuedAt  DateTime        @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Template {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  name        String
  contentJson Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId, type])
}

model PasswordHistory {
  id        String          @id @default(cuid())
  userType  SessionUserType
  userId    String
  hash      String
  createdAt DateTime        @default(now())

  @@index([userType, userId, createdAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  scope      String
  success    Boolean
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, scope, createdAt])
}

model ReservedSlug {
  slug      String   @id
  reason    String
  createdAt DateTime @default(now())
}

model Organization {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String           // URL-friendly identifier within tenant
  type        OrganizationType @default(EXTERNAL)
  logoKey     String?          // S3 key for org logo

  // Contact info
  email       String?
  phone       String?
  address     String?
  state       String?
  lga         String?

  // Financial tracking
  outstandingBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  depositBalance     Decimal   @default(0.00) @db.Decimal(12, 2)

  contactPerson   String?
  contactPhone    String?
  contactPosition String?

  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  stations       Station[]
  users          TenantUser[]     @relation("OrgUsers")
  sales          Sale[]
  priceControls  PriceControl[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("organizations")
}

enum ProductType {
  PMS
  AGO
  DPK
  LPG
}

enum SalesLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DipShift {
  MORNING
  EVENING
}

enum DippingType {
  OPENING
  CLOSING
}

enum TicketStatus {
  OPEN
  PENDING_APPROVAL
  RESOLVED
  CLOSED
}

enum TicketCategory {
  INVENTORY_VARIANCE
  EQUIPMENT_FAULT
  CASH_DISCREPANCY
  OTHER
}

enum StationRole {
  MANAGER
  SUPERVISOR
  CASHIER
  ATTENDANT
  OPERATION_MANAGER
}

enum WaybillStatus {
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  FUEL_FOR_GEN
  MAINTENANCE
  UTILITIES
  STATIONERY
  OTHER
}

enum PaymentMethod {
  CASH
  POS
  BANK_TRANSFER
  CHEQUE
  DEPOSIT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
  ISSUE
}

model Station {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String // e.g., AP-LAG-01
  name           String
  location       String? // Address
  state          String?
  lga            String?
  ward           String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  altitude       Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  staff              TenantUser[]        @relation("StationStaff")
  tanks              Tank[]
  priceControls      PriceControl[]
  dailyReports       DailyStockReport[]
  tickets            Ticket[]
  SalesLogs          SalesLog[]
  waybillAllocations WaybillAllocation[]
  pumps              Pump[]
  expenses           Expense[]

  stationSales    Sale[]           @relation("StationSales")
  dippingSessions DippingSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@map("stations")
}

model Tank {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  name          String // e.g., "PMS Tank 1"
  productType   ProductType
  capacity      Decimal     @db.Decimal(12, 2)
  currentLiters Decimal     @default(0.00) @db.Decimal(12, 2)
  status        AssetStatus @default(ACTIVE)

  dippings        TankDipping[]
  waybillDippings WaybillDipping[]
  pumps           Pump[]
  dippingSessions DippingSession[]
  varianceLogs    VarianceLog[]

  @@index([tenantId])
  @@index([stationId])
  @@map("tanks")
}

// Track historical and current pricing setup per station (org sets its own prices)
model PriceControl {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stationId      String
  station        Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  productType    ProductType
  pricePerLiter  Decimal       @db.Decimal(10, 2)
  effectiveFrom  DateTime      @default(now())

  @@index([tenantId])
  @@index([organizationId])
  @@index([stationId])
  @@map("price_controls")
}

model SalesLog {
  id                 String         @id @default(uuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId          String
  station            Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recordedById       String
  recordedBy         TenantUser     @relation("SalesRecordedBy", fields: [recordedById], references: [id])
  productType        ProductType
  litersSold         Decimal        @db.Decimal(12, 2)
  pricePerLiter      Decimal        @default(0.00) @db.Decimal(10, 2)
  amountPos          Decimal        @db.Decimal(12, 2) // POS payments
  amountTransfer     Decimal        @db.Decimal(12, 2) // Bank transfers
  posReceiptUrl      String?
  transferReceiptUrl String?
  logDate            DateTime       @db.Date
  status             SalesLogStatus @default(PENDING)
  reason             String?        @db.Text
  approvedById       String?
  approvedBy         TenantUser?    @relation("SalesApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  isDebtRepayment Boolean    @default(false)
  parentSaleId    String? // Links to the original sale that was short
  parentSale      SalesLog?  @relation("DebtRepayments", fields: [parentSaleId], references: [id])
  debtRepayments  SalesLog[] @relation("DebtRepayments")

  dippingClosing   DippingClosing?
  dippingClosingId String?         @unique

  posBankAccountId      String?
  posBankAccount        BankAccount? @relation("SalesLogPosBankAccount", fields: [posBankAccountId], references: [id], onDelete: SetNull)
  transferBankAccountId String?
  transferBankAccount   BankAccount? @relation("SalesLogTransferBankAccount", fields: [transferBankAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([stationId])
  @@index([recordedById])
  @@index([approvedById])
  @@map("sales_logs")
}

model DailyStockReport {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId  String
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  reportDate DateTime @db.Date

  openingStockPms Decimal @default(0.00) @db.Decimal(12, 2)
  openingStockAgo Decimal @default(0.00) @db.Decimal(12, 2)
  openingStockDpk Decimal @default(0.00) @db.Decimal(12, 2)

  soldPms Decimal @default(0.00) @db.Decimal(12, 2)
  soldAgo Decimal @default(0.00) @db.Decimal(12, 2)
  soldDpk Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt    DateTime      @default(now())
  tankDippings TankDipping[]

  @@unique([stationId, reportDate])
  @@index([tenantId])
  @@map("daily_stock_reports")
}

model TankDipping {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyStockReportId String?
  dailyStockReport   DailyStockReport? @relation(fields: [dailyStockReportId], references: [id], onDelete: Cascade)
  tankId             String
  tank               Tank              @relation(fields: [tankId], references: [id], onDelete: Cascade)
  shift              DipShift? // MORNING or EVENING
  dippingType        DippingType? // OPENING or CLOSING
  dippingLiters      Decimal           @db.Decimal(12, 2)
  reason             String?
  recordedAt         DateTime          @default(now())

  @@index([tenantId])
  @@index([dailyStockReportId])
  @@index([tankId])
  @@map("tank_dippings")
}

// Tickets system for issues, adjustments, and reports requiring approval
model Ticket {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId    String
  station      Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     TenantUser     @relation("TicketRaiser", fields: [raisedById], references: [id])
  approvedById String?
  approvedBy   TenantUser?    @relation("TicketApprover", fields: [approvedById], references: [id])
  category     TicketCategory
  title        String
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  remark       String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  varianceLog  VarianceLog?

  @@index([tenantId])
  @@index([stationId])
  @@index([raisedById])
  @@index([approvedById])
  @@map("tickets")
}

enum VarianceType {
  TANK_DIPPING
  WAYBILL_DELIVERY
}

model VarianceLog {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId        String      @unique
  ticket          Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  varianceType    VarianceType
  expectedVolume  Decimal     @db.Decimal(12, 2)
  actualVolume    Decimal     @db.Decimal(12, 2)
  varianceVolume  Decimal     @db.Decimal(12, 2)
  
  tankId          String?
  tank            Tank?       @relation(fields: [tankId], references: [id], onDelete: SetNull)
  waybillId       String?
  waybill         Waybill?    @relation(fields: [waybillId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())

  @@index([tenantId])
  @@index([ticketId])
  @@map("variance_logs")
}

// B2B Customers tied directly to a specific Tenant Company
model Customer {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  address            String?
  state              String?
  lga                String?
  contactPerson      String?
  contactPhone       String?
  contactPosition    String?
  outstandingBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  depositBalance     Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  sales        Sale[]
  transactions Transaction[]

  @@index([tenantId])
  @@map("customers")
}

model Waybill {
  id               String      @id @default(uuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number           String // Waybill Number
  productType      ProductType
  litersLoaded     Decimal     @db.Decimal(12, 2)
  truckPlate       String
  driverName       String
  driverPhone      String?
  pictures         String[]    @default([]) // URLs or keys of photos
  dispatchedAt     DateTime    @default(now())
  deliveryDatetime DateTime?

  supplier         String?
  depot            String?
  transportCompany String?

  recordedById String
  recordedBy   TenantUser @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  allocations WaybillAllocation[]
  dippings    WaybillDipping[]
  varianceLogs VarianceLog[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([recordedById])
  @@map("waybills")
}

model WaybillAllocation {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waybillId String
  waybill   Waybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // Volume and financial details per station
  litersToDispense   Decimal  @db.Decimal(12, 2)
  litersReceived     Decimal? @db.Decimal(12, 2)
  costPerLiter       Decimal  @db.Decimal(10, 2)
  transportationCost Decimal  @db.Decimal(12, 2)

  // Delivery details per station
  status          WaybillStatus @default(DISPATCHED)
  gpsLatitude     Decimal?      @db.Decimal(9, 6)
  gpsLongitude    Decimal?      @db.Decimal(9, 6)
  arrivalPictures String[]      @default([])
  arrivalTime     DateTime?
  deliveredAt     DateTime?

  truckNumberVerified Boolean @default(false)
  driverVerified      Boolean @default(false)
  waybillVerified     Boolean @default(false)
  cancellationReason  String? @db.Text

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dippings WaybillDipping[]

  @@unique([waybillId, stationId])
  @@index([tenantId])
  @@index([waybillId])
  @@index([stationId])
  @@index([saleId])
  @@map("waybill_allocations")
}

model Pump {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId String
  station   Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  tankId    String
  tank      Tank        @relation(fields: [tankId], references: [id], onDelete: Cascade)
  name      String // e.g., "Pump 1"
  status    AssetStatus @default(ACTIVE)
  nozzles   Nozzle[]

  @@index([tenantId])
  @@index([stationId])
  @@index([tankId])
  @@map("pumps")
}

model Nozzle {
  id       String      @id @default(uuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pumpId   String
  pump     Pump        @relation(fields: [pumpId], references: [id], onDelete: Cascade)
  name     String // e.g., "Nozzle A"
  status   AssetStatus @default(ACTIVE)

  shiftLogs ShiftLog[]

  @@index([tenantId])
  @@index([pumpId])
  @@map("nozzles")
}

model ShiftLog {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nozzleId    String
  nozzle      Nozzle     @relation(fields: [nozzleId], references: [id], onDelete: Cascade)
  attendantId String
  attendant   TenantUser @relation("AttendantShifts", fields: [attendantId], references: [id], onDelete: Restrict)

  // Meter Readings
  openingMeter Decimal  @db.Decimal(12, 2)
  closingMeter Decimal? @db.Decimal(12, 2)
  litersSold   Decimal? @db.Decimal(12, 2) // Calculated: closing - opening

  // Attendant Cash/POS/Transfer Declarations
  declaredCash     Decimal? @db.Decimal(12, 2)
  declaredPos      Decimal? @db.Decimal(12, 2)
  declaredTransfer Decimal? @db.Decimal(12, 2)

  // Reconciled by Cashier/Supervisor
  reconciledById String?
  reconciledBy   TenantUser? @relation("ReconciledShifts", fields: [reconciledById], references: [id], onDelete: Restrict)
  varianceLiters Decimal     @default(0.00) @db.Decimal(12, 2)
  varianceCash   Decimal     @default(0.00) @db.Decimal(12, 2)
  reconciledAt   DateTime?

  shiftDate DateTime  @db.Date
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([tenantId])
  @@index([nozzleId])
  @@index([attendantId])
  @@index([reconciledById])
  @@map("shift_logs")
}

model Expense {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category      ExpenseCategory
  paymentMethod PaymentMethod
  amount        Decimal         @db.Decimal(12, 2)
  description   String          @db.Text
  receiptUrl    String? // Receipt photo/doc
  status        ExpenseStatus   @default(PENDING)

  bankAccountId String?
  bankAccount   BankAccount? @relation("ExpenseBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)

  recordedById String
  recordedBy   TenantUser  @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   TenantUser? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([stationId])
  @@index([recordedById])
  @@index([approvedById])
  @@map("expenses")
}

model WaybillDipping {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waybillId           String
  waybill             Waybill           @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  waybillAllocationId String
  waybillAllocation   WaybillAllocation @relation(fields: [waybillAllocationId], references: [id], onDelete: Cascade)
  tankId              String
  tank                Tank              @relation(fields: [tankId], references: [id], onDelete: Cascade)
  beforeLiters        Decimal           @db.Decimal(12, 2)
  afterLiters         Decimal?          @db.Decimal(12, 2)
  recordedById        String
  recordedBy          TenantUser        @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())

  @@index([tenantId])
  @@index([waybillId])
  @@index([waybillAllocationId])
  @@map("waybill_dippings")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("suppliers")
}

model Depot {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("depots")
}

model TransportCompany {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("transport_companies")
}

// ==========================================
// FLEET MANAGEMENT SYSTEM MODELS
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  LOADED
  CHANGED
  CANCELLED
  COMPLETED
}

enum TransportStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
  LOSS
}

enum SaleStatus {
  UNPAID
  PART_PAID
  CLEARED
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum TransactionCategory {
  TRANSPORT_PAYMENT
  CLIENT_PAYMENT
  EXPENSE
  OTHER
}

enum PaymentType {
  ADVANCE_DEPOSIT
  PART_PAYMENT
  FULL_SETTLEMENT
  DEBT_CLEARANCE
}

model Transporter {
  id                 String      @id @default(uuid())
  tenantId           String
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  registrationNumber String?
  businessType       String?
  contactPerson      String?
  contactPhone       String?
  contactPosition    String?
  state              String?
  lga                String?
  ward               String?
  address            String?
  kycDocuments       Json        @default("{}")
  status             AssetStatus @default(ACTIVE)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  trucks       Truck[]
  drivers      Driver[]
  transports   Transport[]
  transactions Transaction[]

  @@index([tenantId])
  @@map("fleet_transporters")
}

model Truck {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transporterId  String
  transporter    Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  name           String // Plate Number or Truck ID
  truckNumber    String?
  plateNumber    String?
  truckBrand     String?
  model          String?
  truckType      String?
  fuelType       String?
  capacityLiters Decimal     @db.Decimal(12, 2)
  status         AssetStatus @default(ACTIVE)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transports         Transport[]
  maintenanceHistory TruckMaintenanceHistory[]
  transactions       Transaction[]

  @@index([tenantId])
  @@index([transporterId])
  @@map("fleet_trucks")
}

model TruckMaintenanceHistory {
  id          String   @id @default(uuid())
  truckId     String
  truck       Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  description String   @db.Text
  cost        Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([truckId])
  @@map("fleet_truck_maintenance_history")
}

model Driver {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transporterId     String
  transporter       Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String?
  licenseNumber     String?
  licenseExpiryDate DateTime?   @db.Date
  address           String?
  status            AssetStatus @default(ACTIVE)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  transports Transport[]

  @@index([tenantId])
  @@index([transporterId])
  @@map("fleet_drivers")
}

model Order {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference     String? // Optional Reference e.g. O-1001
  productType   ProductType
  litersOrdered Decimal     @db.Decimal(12, 2)
  supplier      String?
  sourceDepot   String?
  pricePerLitre Decimal     @default(0.00) @db.Decimal(12, 2)
  loadingCost   Decimal     @default(0.00) @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transports   Transport[]
  transactions Transaction[]

  @@index([tenantId])
  @@map("fleet_orders")
}

model Transport {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  truckId       String
  truck         Truck       @relation(fields: [truckId], references: [id], onDelete: Restrict)
  driverId      String
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Restrict)

  destination   String
  productType   ProductType?
  ratePerLiter  Decimal      @db.Decimal(10, 2)
  litersCarried Decimal      @db.Decimal(12, 2)

  subsequentLocs Json @default("[]") // Array of { location, rate, litersDelivered }

  litersDelivered     Decimal? @db.Decimal(12, 2)
  maintenanceCost     Decimal  @default(0.00) @db.Decimal(12, 2)
  litersLost          Decimal  @default(0.00) @db.Decimal(12, 2)
  totalDeduction      Decimal  @default(0.00) @db.Decimal(12, 2)
  netTransportFeePaid Decimal  @default(0.00) @db.Decimal(12, 2)

  comment   String?         @db.Text
  status    TransportStatus @default(IN_TRANSIT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  sales        Sale[]
  lossLogs     TransportLossLog[]
  transactions Transaction[]

  @@index([tenantId])
  @@index([orderId])
  @@index([transporterId])
  @@index([truckId])
  @@index([driverId])
  @@map("fleet_transports")
}

enum LossType {
  THEFT
  MAINTENANCE
  ACCIDENT
  OTHERS
}

model TransportLossLog {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transportId String
  transport   Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)

  lossType         LossType
  lostQuantity     Decimal  @db.Decimal(12, 2)
  expensesIncurred Decimal  @db.Decimal(12, 2)
  comment          String?  @db.Text

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([transportId])
  @@map("fleet_transport_loss_logs")
}

model Sale {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stationId      String?
  station        Station?      @relation("StationSales", fields: [stationId], references: [id], onDelete: Restrict)
  transportId    String?
  transport      Transport?    @relation(fields: [transportId], references: [id], onDelete: SetNull)

  litersDespatched    Decimal  @db.Decimal(12, 2)
  litersReceived      Decimal? @db.Decimal(12, 2)
  amountPerLiter      Decimal  @db.Decimal(10, 2)
  totalExpectedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentReceived     Decimal  @default(0.00) @db.Decimal(12, 2)

  transportRate        Decimal? @db.Decimal(10, 2) // ₦/L for sub-destination transport
  transportCost        Decimal  @default(0.00) @db.Decimal(12, 2) // Total transport cost for this allocation
  transportCostBorneBy String   @default("CLIENT") // "CLIENT" | "COMPANY"

  status    SaleStatus @default(UNPAID)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  transactions       Transaction[]
  waybillAllocations WaybillAllocation[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([customerId])
  @@index([stationId])
  @@index([transportId])
  @@map("fleet_sales")
}

model Transaction {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           TransactionType
  category       TransactionCategory
  paymentType    PaymentType?
  amount         Decimal             @db.Decimal(12, 2)
  paymentPurpose String?
  description    String?             @db.Text
  reference      String?
  paymentMethod  PaymentMethod?
  receiptUrl     String?

  bankAccountId String?
  bankAccount   BankAccount? @relation("TransactionBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  transporterId String?
  transporter   Transporter? @relation(fields: [transporterId], references: [id], onDelete: SetNull)

  transportId String?
  transport   Transport? @relation(fields: [transportId], references: [id], onDelete: SetNull)

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([saleId])
  @@index([transporterId])
  @@index([transportId])
  @@index([truckId])
  @@index([orderId])
  @@map("fleet_transactions")
}

enum DippingSessionStatus {
  OPEN
  COMPLETED
}

enum ClosingReason {
  END_OF_DAY
  PRICE_CHANGE
  ROUTINE
}

model DippingSession {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tankId    String
  tank      Tank    @relation(fields: [tankId], references: [id], onDelete: Cascade)
  stationId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  openingLiters Decimal  @db.Decimal(12, 2)
  pricePerLiter Decimal  @db.Decimal(10, 2) // Price at session open
  openedAt      DateTime @default(now())

  status      DippingSessionStatus @default(OPEN)
  completedAt DateTime?

  closings DippingClosing[]

  @@index([tenantId])
  @@index([stationId])
  @@index([tankId])
  @@map("dipping_sessions")
}

model DippingClosing {
  id        String         @id @default(uuid())
  sessionId String
  session   DippingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  closingLiters Decimal       @db.Decimal(12, 2)
  reason        ClosingReason

  // If reason is PRICE_CHANGE, store the new price for the NEXT reading
  newPricePerLiter Decimal? @db.Decimal(10, 2)

  // The price that applies to THIS closing's sale calculation
  appliedPrice Decimal @db.Decimal(10, 2)

  recordedAt DateTime @default(now())

  // Auto-generated sale from this closing
  generatedSale   SalesLog? @relation(fields: [generatedSaleId], references: [id])
  generatedSaleId String?   @unique

  @@index([sessionId])
  @@map("dipping_closings")
}

enum AccountScope {
  STATION
  FLEET
}

model BankAccount {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope         AccountScope
  accountName   String
  accountNumber String
  bankName      String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  posSalesLogs      SalesLog[]    @relation("SalesLogPosBankAccount")
  transferSalesLogs SalesLog[]    @relation("SalesLogTransferBankAccount")
  expenses          Expense[]     @relation("ExpenseBankAccount")
  transactions      Transaction[] @relation("TransactionBankAccount")

  @@index([tenantId])
  @@map("bank_accounts")
}
