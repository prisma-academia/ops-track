generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum ActorType {
  PLATFORM_USER
  TENANT_USER
  CLIENT
  SYSTEM
}

enum SessionUserType {
  PLATFORM
  TENANT
  CLIENT
}

enum SessionScope {
  FULL
  MUST_CHANGE_PASSWORD
}

enum OtpPurpose {
  CLIENT_LOGIN
  CLIENT_SIGNUP
  TENANT_REGISTRATION
  TENANT_OWNER_CHANGE_EMAIL
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  status       TenantStatus @default(ACTIVE)
  ownerUserId  String?
  companyEmail String?
  companyPhone String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  settingsJson Json         @default("{}")
  createdAt    DateTime     @default(now())
  archivedAt   DateTime?

  users                      TenantUser[]
  clients                    Client[]
  pendingClientRegistrations PendingClientRegistration[]
  roleTemplates              RoleTemplate[]
  templates                  Template[]
  activityLogs               ActivityLog[]
  stations                   Station[]
  tanks                      Tank[]
  priceControls              PriceControl[]
  dailySalesLogs             DailySalesLog[]
  dailyStockReports          DailyStockReport[]
  tankDippings               TankDipping[]
  tickets                    Ticket[]
  customers                  Customer[]
  waybills                   Waybill[]
  waybillDippings            WaybillDipping[]
  pumps                      Pump[]
  nozzles                    Nozzle[]
  shiftLogs                  ShiftLog[]
  expenses                   Expense[]

  @@index([status])
}

model PlatformUser {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  status              UserStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isSuperAdmin        Boolean    @default(false)
  permissions         String[]   @default([])
  createdAt           DateTime   @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
}

model TenantUser {
  id                  String     @id @default(cuid())
  tenantId            String
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  status              UserStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isOwner             Boolean    @default(false)
  permissions         String[]   @default([])
  createdAt           DateTime   @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  expoPushTokens      String[]   @default([])

  stations          Station[]       @relation("StationStaff")
  recordedSalesLogs DailySalesLog[] @relation("SalesRecordedBy")
  raisedTickets     Ticket[]        @relation("TicketRaiser")
  approvedTickets   Ticket[]        @relation("TicketApprover")
  recordedWaybills  Waybill[]
  attendantShifts   ShiftLog[]      @relation("AttendantShifts")
  reconciledShifts  ShiftLog[]      @relation("ReconciledShifts")
  recordedExpenses  Expense[]       @relation("ExpenseRecordedBy")
  approvedExpenses  Expense[]       @relation("ExpenseApprovedBy")
  recordedWaybillDippings WaybillDipping[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String?
  mustChangePassword  Boolean      @default(false)
  status              ClientStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  profileJson         Json         @default("{}")
  createdAt           DateTime     @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model PasswordResetToken {
  id         String          @id @default(cuid())
  tokenHash  String          @unique
  userType   SessionUserType
  userId     String
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([expiresAt])
}

/// In-flight client self-signup: created after form+password, deleted after OTP verifies.
model PendingClientRegistration {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  otherName    String?
  phone        String?
  profileJson  Json     @default("{}")
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RoleTemplate {
  id          String    @id @default(cuid())
  scope       RoleScope
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([scope, tenantId, name])
  @@index([scope, tenantId])
}

model Permission {
  key         String @id
  module      String
  description String
}

model ActivityLog {
  id         String    @id @default(cuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorType  ActorType
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
}

model OtpRequest {
  id         String     @id @default(cuid())
  identifier String
  codeHash   String
  purpose    OtpPurpose
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([identifier, createdAt])
  @@index([tenantId])
}

model Session {
  id        String          @id
  userId    String
  userType  SessionUserType
  tenantId  String?
  scope     SessionScope    @default(FULL)
  issuedAt  DateTime        @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Template {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  name        String
  contentJson Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId, type])
}

model PasswordHistory {
  id        String          @id @default(cuid())
  userType  SessionUserType
  userId    String
  hash      String
  createdAt DateTime        @default(now())

  @@index([userType, userId, createdAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  scope      String
  success    Boolean
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, scope, createdAt])
}

model ReservedSlug {
  slug      String   @id
  reason    String
  createdAt DateTime @default(now())
}

enum ProductType {
  PMS
  AGO
  DPK
  LPG
}

enum DipShift {
  MORNING
  EVENING
}

enum TicketStatus {
  OPEN
  PENDING_APPROVAL
  RESOLVED
  CLOSED
}

enum TicketCategory {
  INVENTORY_VARIANCE
  EQUIPMENT_FAULT
  CASH_DISCREPANCY
  OTHER
}

enum StationRole {
  MANAGER
  SUPERVISOR
  CASHIER
  ATTENDANT
  OPERATION_MANAGER
}

enum WaybillStatus {
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  FUEL_FOR_GEN
  MAINTENANCE
  UTILITIES
  STATIONERY
  OTHER
}

enum ExpensePaymentMethod {
  CASH
  POS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
  ISSUE
}

model Station {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String // e.g., AP-LAG-01
  name      String
  region    String // e.g., North-West, South-West
  location  String? // Address
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff          TenantUser[]       @relation("StationStaff")
  tanks          Tank[]
  priceControls  PriceControl[]
  dailyReports   DailyStockReport[]
  tickets        Ticket[]
  dailySalesLogs DailySalesLog[]
  waybills       Waybill[]
  pumps          Pump[]
  expenses       Expense[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("stations")
}

model Tank {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId   String
  station     Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  name        String // e.g., "PMS Tank 1"
  productType ProductType
  capacity    Decimal     @db.Decimal(12, 2)
  status      AssetStatus @default(ACTIVE)

  dippings TankDipping[]
  waybillDippings WaybillDipping[]
  pumps    Pump[]

  @@index([tenantId])
  @@index([stationId])
  @@map("tanks")
}

// Track historical and current pricing setup per station
model PriceControl {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  productType   ProductType
  pricePerLiter Decimal     @db.Decimal(10, 2)
  effectiveFrom DateTime    @default(now())

  @@index([tenantId])
  @@index([stationId])
  @@map("price_controls")
}

model DailySalesLog {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId      String
  station        Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recordedById   String
  recordedBy     TenantUser  @relation("SalesRecordedBy", fields: [recordedById], references: [id])
  productType    ProductType
  litersSold     Decimal     @db.Decimal(12, 2)
  amountCash     Decimal     @db.Decimal(12, 2) // Cash collected
  amountPos      Decimal     @db.Decimal(12, 2) // POS payments
  amountTransfer Decimal     @db.Decimal(12, 2) // Bank transfers
  cashReceiptUrl String?
  posReceiptUrl  String?
  logDate        DateTime    @db.Date

  @@index([tenantId])
  @@index([stationId])
  @@index([recordedById])
  @@map("daily_sales_logs")
}

model DailyStockReport {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId  String
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  reportDate DateTime @db.Date

  openingStockPms Decimal @default(0.00) @db.Decimal(12, 2)
  openingStockAgo Decimal @default(0.00) @db.Decimal(12, 2)
  openingStockDpk Decimal @default(0.00) @db.Decimal(12, 2)

  soldPms Decimal @default(0.00) @db.Decimal(12, 2)
  soldAgo Decimal @default(0.00) @db.Decimal(12, 2)
  soldDpk Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt    DateTime      @default(now())
  tankDippings TankDipping[]

  @@unique([stationId, reportDate])
  @@index([tenantId])
  @@map("daily_stock_reports")
}

model TankDipping {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyStockReportId String?
  dailyStockReport   DailyStockReport? @relation(fields: [dailyStockReportId], references: [id], onDelete: Cascade)
  tankId             String
  tank               Tank              @relation(fields: [tankId], references: [id], onDelete: Cascade)
  shift              DipShift? // MORNING or EVENING
  dippingLiters      Decimal           @db.Decimal(12, 2)
  reason             String?
  recordedAt         DateTime          @default(now())

  @@index([tenantId])
  @@index([dailyStockReportId])
  @@index([tankId])
  @@map("tank_dippings")
}

// Tickets system for issues, adjustments, and reports requiring approval
model Ticket {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId    String
  station      Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     TenantUser     @relation("TicketRaiser", fields: [raisedById], references: [id])
  approvedById String?
  approvedBy   TenantUser?    @relation("TicketApprover", fields: [approvedById], references: [id])
  category     TicketCategory
  title        String
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  remark       String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([stationId])
  @@index([raisedById])
  @@index([approvedById])
  @@map("tickets")
}

// B2B Customers tied directly to a specific Tenant Company
model Customer {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  outstandingBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@map("customers")
}

model Waybill {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId      String
  station        Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  number         String // Waybill Number
  productType    ProductType
  litersLoaded   Decimal       @db.Decimal(12, 2)
  litersReceived Decimal?      @db.Decimal(12, 2) // Transit variance checking
  truckPlate     String
  driverName     String
  driverPhone    String?
  status         WaybillStatus @default(DISPATCHED)
  gpsLatitude    Decimal?      @db.Decimal(9, 6)
  gpsLongitude   Decimal?      @db.Decimal(9, 6)
  pictures            String[]      @default([]) // URLs or keys of photos
  arrivalPictures     String[]      @default([]) // Truck, truck number, and location photos on arrival
  dispatchedAt        DateTime      @default(now())
  deliveryDatetime    DateTime?
  arrivalTime         DateTime?
  deliveredAt         DateTime?
  
  supplier            String?
  depot               String?
  transportCompany    String?

  truckNumberVerified Boolean       @default(false)
  driverVerified      Boolean       @default(false)
  waybillVerified     Boolean       @default(false)

  recordedById String
  recordedBy   TenantUser @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  dippings     WaybillDipping[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([stationId])
  @@index([recordedById])
  @@map("waybills")
}

model Pump {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  tankId    String
  tank      Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
  name      String // e.g., "Pump 1"
  status    AssetStatus @default(ACTIVE)
  nozzles   Nozzle[]

  @@index([tenantId])
  @@index([stationId])
  @@index([tankId])
  @@map("pumps")
}

model Nozzle {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pumpId   String
  pump     Pump   @relation(fields: [pumpId], references: [id], onDelete: Cascade)
  name     String // e.g., "Nozzle A"
  status   AssetStatus @default(ACTIVE)

  shiftLogs ShiftLog[]

  @@index([tenantId])
  @@index([pumpId])
  @@map("nozzles")
}

model ShiftLog {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nozzleId    String
  nozzle      Nozzle     @relation(fields: [nozzleId], references: [id], onDelete: Cascade)
  attendantId String
  attendant   TenantUser @relation("AttendantShifts", fields: [attendantId], references: [id], onDelete: Restrict)

  // Meter Readings
  openingMeter Decimal  @db.Decimal(12, 2)
  closingMeter Decimal? @db.Decimal(12, 2)
  litersSold   Decimal? @db.Decimal(12, 2) // Calculated: closing - opening

  // Attendant Cash/POS/Transfer Declarations
  declaredCash     Decimal? @db.Decimal(12, 2)
  declaredPos      Decimal? @db.Decimal(12, 2)
  declaredTransfer Decimal? @db.Decimal(12, 2)

  // Reconciled by Cashier/Supervisor
  reconciledById String?
  reconciledBy   TenantUser? @relation("ReconciledShifts", fields: [reconciledById], references: [id], onDelete: Restrict)
  varianceLiters Decimal     @default(0.00) @db.Decimal(12, 2)
  varianceCash   Decimal     @default(0.00) @db.Decimal(12, 2)
  reconciledAt   DateTime?

  shiftDate DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([nozzleId])
  @@index([attendantId])
  @@index([reconciledById])
  @@map("shift_logs")
}

model Expense {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category      ExpenseCategory
  paymentMethod ExpensePaymentMethod
  amount        Decimal              @db.Decimal(12, 2)
  description   String               @db.Text
  receiptUrl    String? // Receipt photo/doc
  status        ExpenseStatus        @default(PENDING)

  recordedById String
  recordedBy   TenantUser  @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   TenantUser? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([stationId])
  @@index([recordedById])
  @@index([approvedById])
  @@map("expenses")
}

model WaybillDipping {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waybillId    String
  waybill      Waybill    @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  tankId       String
  tank         Tank       @relation(fields: [tankId], references: [id], onDelete: Cascade)
  beforeLiters Decimal    @db.Decimal(12, 2)
  afterLiters  Decimal?   @db.Decimal(12, 2)
  recordedById String
  recordedBy   TenantUser @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([waybillId])
  @@map("waybill_dippings")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("suppliers")
}

model Depot {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("depots")
}

model TransportCompany {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("transport_companies")
}
